# e2e 테스트 전용 환경. 비밀값 없음 — 커밋 대상. 인프라: docker compose up -d postgres redis mock
NODE_ENV=test
API_PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alarm
DB_PASSWORD=alarm
DB_NAME=alarm_test
DB_SYNCHRONIZE=true
REDIS_HOST=localhost
REDIS_PORT=6379
MOCK_API_BASE_URL=http://localhost:4000
MOCK_API_PORT=4000
SEND_RATE_LIMIT_PER_SEC=45
SEND_REQUEST_TIMEOUT_MS=5000
SEND_MAX_ATTEMPTS=3
SEND_LEASE_SEC=10
WORKER_CONCURRENCY=2
RECOVERY_SWEEP_INTERVAL_MS=5000
SEND_RECONCILE_DELAY_MS=1000
RUN_MIGRATIONS=false
