# 로컬 환경변수 템플릿. 복사해서 사용: cp .env.sample .env
# 키를 추가·변경하면 이 파일도 함께 수정한다 (docs/conventions/config.md)
# docker compose 는 이 파일(.env)을 자동으로 읽어 ${KEY} 를 치환한다.

# 실행 환경 (local | test | production)
NODE_ENV=local
# API 서버 포트
API_PORT=3000

# PostgreSQL (compose 서비스명 postgres, 로컬 직접 실행 시 localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alarm
DB_PASSWORD=alarm
DB_NAME=alarm
# 개발 편의용 스키마 자동 동기화. 운영(production)에서는 반드시 false 로 두고 마이그레이션을 사용한다.
DB_SYNCHRONIZE=false

# Redis (compose 서비스명 redis, 로컬 직접 실행 시 localhost)
REDIS_HOST=localhost
REDIS_PORT=6379

# 외부 발송 mock 서버 (ghcr.io/us-all/backend-assignment-api:1.2)
# compose 내부에서는 http://mock:<포트>, 로컬 직접 실행 시 http://localhost:<포트>
# 컨테이너 내부 포트는 4000 고정 (이미지 EXPOSE)
MOCK_API_BASE_URL=http://localhost:4000
# mock 서버 호스트 포트 매핑 (compose 의 mock 서비스, 호스트:4000)
MOCK_API_PORT=4000
# 외부 API 처리량 제한 (초당 건수) — 워커 전체가 공유
SEND_RATE_LIMIT_PER_SEC=50
# 외부 API 요청 타임아웃(ms). mock 은 약 2% 요청이 30초 무응답이므로 이보다 짧게 끊고 재조회/재시도한다
SEND_REQUEST_TIMEOUT_MS=5000
