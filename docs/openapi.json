{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "API 프로세스가 요청을 받을 수 있는지 확인한다.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/HealthResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "헬스체크",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/alarms": {
      "post": {
        "description": "CREATED 상태로 생성한다. URGENT 는 recipientIds(1~100명) 필수, BULK 는 지정 불가(전체 사용자).",
        "operationId": "AlarmController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlarmRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성됨",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AlarmResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "검증 실패 / 수신자 지정 오류 (VALIDATION_FAILED / ALARM_RECIPIENTS_INVALID)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED",
                                "ALARM_RECIPIENTS_INVALID"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "알림 생성",
        "tags": [
          "Alarm"
        ]
      },
      "get": {
        "description": "생성일 역순. status/type 으로 필터할 수 있다.",
        "operationId": "AlarmController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "페이지 번호 (0-based)",
            "schema": {
              "default": 0,
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "페이지 크기 (최대 100)",
            "schema": {
              "default": 10,
              "example": 10,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "상태 필터",
            "schema": {
              "example": "SENDING",
              "type": "string",
              "enum": [
                "CREATED",
                "PREPARING",
                "SENDING",
                "COMPLETED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "description": "종류 필터",
            "schema": {
              "example": "BULK",
              "type": "string",
              "enum": [
                "BULK",
                "URGENT"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PagedResponse"
                            },
                            {
                              "properties": {
                                "items": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/AlarmResponse"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "쿼리 검증 실패 (page/size/status/type) (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "알림 목록 조회",
        "tags": [
          "Alarm"
        ]
      }
    },
    "/api/v1/alarms/{id}": {
      "get": {
        "description": "알림과 수신자 상태별 집계(progress)를 함께 돌려준다.",
        "operationId": "AlarmController_getOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "알림 id (uuid)",
            "schema": {
              "example": "3f1c2a9e-8b1d-4c2a-9f1e-2d3c4b5a6f70",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AlarmDetailResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "id 가 uuid 형식이 아님 (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "알림 없음 (ALARM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 404
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_NOT_FOUND"
                              ],
                              "example": "ALARM_NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "알림 단건 조회",
        "tags": [
          "Alarm"
        ]
      }
    },
    "/api/v1/alarms/{id}/send": {
      "post": {
        "description": "CREATED 알림만 시작할 수 있다. 수신자 적재와 발송은 워커가 비동기로 처리하므로 202 를 돌려주고 상태는 PREPARING 이 된다.",
        "operationId": "AlarmController_startSend",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "알림 id (uuid)",
            "schema": {
              "example": "3f1c2a9e-8b1d-4c2a-9f1e-2d3c4b5a6f70",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "발송 요청 수락",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AlarmResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "id 가 uuid 형식이 아님 (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "알림 없음 (ALARM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 404
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_NOT_FOUND"
                              ],
                              "example": "ALARM_NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "이미 시작됐거나 종료된 알림 (ALARM_INVALID_STATUS)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 409
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_INVALID_STATUS"
                              ],
                              "example": "ALARM_INVALID_STATUS"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "알림 발송 시작",
        "tags": [
          "Alarm"
        ]
      }
    },
    "/api/v1/alarms/{id}/cancel": {
      "post": {
        "description": "CREATED/PREPARING/SENDING 알림을 취소한다. 아직 보내지 않은 수신자는 CANCELLED, 이미 보낸 수신자는 SENT 로 남는다.",
        "operationId": "AlarmController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "알림 id (uuid)",
            "schema": {
              "example": "3f1c2a9e-8b1d-4c2a-9f1e-2d3c4b5a6f70",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "취소됨",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AlarmResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "id 가 uuid 형식이 아님 (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "알림 없음 (ALARM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 404
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_NOT_FOUND"
                              ],
                              "example": "ALARM_NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "이미 완료·취소된 알림 (ALARM_INVALID_STATUS)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 409
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_INVALID_STATUS"
                              ],
                              "example": "ALARM_INVALID_STATUS"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "알림 발송 취소",
        "tags": [
          "Alarm"
        ]
      }
    },
    "/api/v1/alarms/{id}/recipients": {
      "get": {
        "description": "상태로 필터해 실패·미확정 수신자를 확인한다.",
        "operationId": "AlarmController_listRecipients",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "알림 id (uuid)",
            "schema": {
              "example": "3f1c2a9e-8b1d-4c2a-9f1e-2d3c4b5a6f70",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "페이지 번호 (0-based)",
            "schema": {
              "default": 0,
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "페이지 크기 (최대 100)",
            "schema": {
              "default": 10,
              "example": 10,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "수신자 상태 필터",
            "schema": {
              "example": "FAILED",
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "SENT",
                "FAILED",
                "UNKNOWN",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PagedResponse"
                            },
                            {
                              "properties": {
                                "items": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/AlarmRecipientResponse"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "id 형식 / 쿼리 검증 실패 (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 400
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "VALIDATION_FAILED"
                              ],
                              "example": "VALIDATION_FAILED"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "알림 없음 (ALARM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseDTO"
                    },
                    {
                      "properties": {
                        "code": {
                          "example": 404
                        },
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "ALARM_NOT_FOUND"
                              ],
                              "example": "ALARM_NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "수신자별 발송 상태 조회",
        "tags": [
          "Alarm"
        ]
      }
    }
  },
  "info": {
    "title": "Alarm Dispatch API",
    "description": "다수 수신자 알림 생성·조회·발송·취소 API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "에러 코드 (ErrorCode.code)",
            "example": "ALARM_NOT_FOUND"
          },
          "details": {
            "description": "상세 사유 목록 (검증 실패 시 필드별 메시지). 없으면 생략",
            "example": [
              "title must be longer than or equal to 1 characters"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code"
        ]
      },
      "ResponseDTO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "HTTP 상태 코드",
            "example": 200
          },
          "message": {
            "type": "object",
            "description": "응답 메시지. 성공 시 null, 에러 시 사용자 노출 메시지",
            "example": null,
            "nullable": true
          },
          "data": {
            "type": "object",
            "description": "응답 데이터. 에러 시 null",
            "example": {},
            "nullable": true
          },
          "error": {
            "description": "에러 정보. 성공 시 생략",
            "example": {
              "code": "ALARM_NOT_FOUND"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              }
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "서버 상태",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "AlarmResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "알림 id (uuid)",
            "example": "3f1c2a9e-8b1d-4c2a-9f1e-2d3c4b5a6f70"
          },
          "type": {
            "type": "string",
            "description": "알림 종류",
            "enum": [
              "BULK",
              "URGENT"
            ],
            "example": "BULK"
          },
          "title": {
            "type": "string",
            "description": "제목",
            "example": "11월 정기 점검 안내"
          },
          "body": {
            "type": "string",
            "description": "본문",
            "example": "11월 25일 02:00~04:00 서비스 점검이 있습니다."
          },
          "status": {
            "type": "string",
            "description": "알림 상태",
            "enum": [
              "CREATED",
              "PREPARING",
              "SENDING",
              "COMPLETED",
              "CANCELLED"
            ],
            "example": "CREATED"
          },
          "createdAt": {
            "type": "string",
            "description": "생성 시각",
            "format": "date-time",
            "example": "2026-11-20T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "수정 시각",
            "format": "date-time",
            "example": "2026-11-20T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "body",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateAlarmRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "알림 종류. BULK 는 전체 사용자, URGENT 는 지정 수신자에게 우선 발송",
            "enum": [
              "BULK",
              "URGENT"
            ],
            "example": "BULK",
            "default": "BULK"
          },
          "title": {
            "type": "string",
            "description": "제목 (공백 제외 1~200자)",
            "example": "11월 정기 점검 안내"
          },
          "body": {
            "type": "string",
